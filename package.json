{
  "name": "window-plugin",
  "version": "1.0.4",
  "description": "This module adds $window and $document properties to Vue components.",
  "main": "dist/index.js",
  "scripts": {
    "serve": "vue-cli-service serve --open",
    "build": "vue-cli-service build",
    "test": "vue-cli-service test",
    "webpack": "webpack"
  },
  "keywords": [
    "vue",
    "window",
    "document",
    "plugin",
    "console",
    "log",
    "alert"
  ],
  "author": "TwelveTone LLC",
  "license": "ISC",
  "dependencies": {
    "vue": "^2.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^3.0.0-beta.9",
    "@vue/cli-plugin-unit-mocha": "^3.0.0-beta.9",
    "@vue/cli-service": "^3.0.0-beta.9",
    "@vue/test-utils": "^1.0.0-beta.10",
    "ajv": "^6.4.0",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.4",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-es2015": "^6.24.1",
    "chai": "^4.1.2",
    "vue-template-compiler": "^2.5.13",
    "webpack": "^3.11.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "vue": {
    "lintOnSave": true,
    "configureWebpack": {
      "externals": {
        "Vue": "Vue"
      },
      "output": {
        "filename": "index.js",
        "libraryTarget": "umd"
      },
      "target": "web"
    }
  },
  "babel": {
    "presets": []
  },
  "eslintConfig": {
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ]
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
