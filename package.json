{
  "name": "window-plugin",
  "version": "2.0.0",
  "description": "This module adds $window and $document properties to Vue components.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "pretest": "rollup -c",
    "test": "vitest run",
    "prepublishOnly": "rollup -c && vitest run"
  },
  "keywords": [
    "code-evolve",
    "vue",
    "window",
    "document",
    "plugin",
    "console",
    "log",
    "alert"
  ],
  "author": "Steven Spungin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-evolve/window-plugin.git"
  },
  "homepage": "https://code-evolve.com/resources/window-plugin",
  "bugs": {
    "url": "https://github.com/code-evolve/window-plugin/issues"
  },
  "peerDependencies": {
    "vue": "^2.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^1.3.6",
    "happy-dom": "^21.0.1",
    "rollup": "^4.64.6",
    "vitest": "^4.1.11",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  }
}
